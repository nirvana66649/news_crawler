# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_DATABASE=news
DB_POOL_MINSIZE=1
DB_POOL_MAXSIZE=10
DB_POOL_RECYCLE=3600

# 爬虫配置
CRAWLER_WEBHOOK_URL=http://localhost:5678/webhook/test
CRAWLER_TIMEOUT=600
CRAWLER_BATCH_SIZE=2
CRAWLER_BATCH_DELAY=5
CRAWLER_RETRY_ATTEMPTS=3
CRAWLER_RETRY_DELAY=10


# 调度器配置
SCHEDULER_CRAWL_INTERVAL=86400  # 24小时
SCHEDULER_ERROR_SLEEP=300

# 应用配置
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Shanghai
APP_CORS_ORIGINS=["*"]
