# Local environment template for News Crawler.
# Copy this file to .env and replace placeholder values:
#   cp .env.example .env
# Never commit .env — it is gitignored.

# Database (the app reads DB_DATABASE, not DB_NAME)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_DATABASE=news

# Crawler
CRAWLER_WEBHOOK_URL=http://localhost:5678/webhook/test
CRAWLER_TIMEOUT=600
CRAWLER_BATCH_SIZE=2
CRAWLER_BATCH_DELAY=5
CRAWLER_RETRY_ATTEMPTS=3
CRAWLER_RETRY_DELAY=10

# Scheduler
SCHEDULER_CRAWL_INTERVAL=86400
SCHEDULER_ERROR_SLEEP=300

# Application
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Shanghai
APP_CORS_ORIGINS=["*"]
