      "parameters": {
        "jsCode": "const input = $('Webhook').first().json.body;\n\nif (!input || !input.keyword || typeof input.keyword !== 'string') {\n  throw new Error(\"字段 'keyword' 缺失或不是字符串\");\n}\n\nconst keywords = input.keyword\n  .split(/[,，]/)\n  .map(k => k.trim())\n  .filter(Boolean);\n\nreturn keywords.map(kw => ({\n  json: {\n    ...input,\n    keyword: kw\n  }\n}));\n"
      },
