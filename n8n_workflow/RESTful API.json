      "parameters": {
        "jsCode": "const newData = $('Webhook1').first().json.body;\nconst oldData = $items(\"MySQL1\")[0].json;\n\nif (oldData.is_deleted !== 0) {\n  // 记录已删除，不允许更新\n  return [{\n    json: {\n      code: 410,\n      show: 0,\n      msg: \"订阅信息已删除，无法修改\",\n      data: {\n        message: \"订阅信息已删除，无法修改\"\n      }\n    }\n  }];\n}\n\nconst updatableFields = ['keyword', 'url', 'frequency_type', 'frequency_value'];\n\nconst updateParts = [];\n\nfor (const field of updatableFields) {\n  if (field in newData && newData[field] !== oldData[field]) {\n    const value = typeof newData[field] === 'string'\n      ? `'${newData[field].replace(/'/g, \"''\")}'` // 防止SQL注入/语法错误\n      : newData[field];\n    updateParts.push(`${field} = ${value}`);\n  }\n}\n\nif (updateParts.length === 0) {\n  return [{\n    json: {\n      code: 400,\n      show: 0,\n      msg: \"没有可修改字段\",\n      data: {\n        message: \"没有可修改字段\"\n      }\n    }\n  }];\n}\n\n// 后面的返回保持原样不变\nconst sql = `\n  UPDATE user_subscriptions\n  SET ${updateParts.join(', ')}\n  WHERE id = '${newData.subscription_id}'\n    AND user_id = ${newData.user_id}\n    AND is_deleted = 0;\n`;\n\nreturn [{ json: { query: sql.trim(), updated: true } }];\n"
      },
