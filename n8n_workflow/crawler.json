      "parameters": {
        "jsCode": "const allItems = $input.all();\nlet newsData = [];\n\n// 遍历所有输入项\nfor (const item of allItems) {\n  const rawContent = item.json.output || \"\";\n\n  // 尝试提取 JSON 数组文本\n  const jsonMatch = rawContent.match(/(\\[.*\\])/s);\n\n  if (jsonMatch) {\n    try {\n      const parsed = JSON.parse(jsonMatch[1]);\n      if (Array.isArray(parsed)) {\n        newsData.push(...parsed);\n      }\n    } catch (e) {\n      // 解析失败忽略\n    }\n  } else if (Array.isArray(rawContent)) {\n    newsData.push(...rawContent);\n  } else if (typeof rawContent === 'object' && rawContent !== null) {\n    newsData.push(rawContent);\n  }\n}\n\n// 只提取需要的字段\nconst articles = newsData.map(item => ({\n  title: item.title || '',\n  summary: item.summary || '',\n  url: item.url || ''\n}));\n\n// 包装成指定 JSON 结构\nreturn [\n  {\n    json: {\n      articles: articles\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
