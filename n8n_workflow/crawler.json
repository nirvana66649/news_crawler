      "parameters": {
        "jsCode": "const raw = $input.first().json.output;\nconst content = typeof raw === 'string' ? raw : '';\n\n// 获取 </think> 后的部分\nconst parts = content.split('</think>');\nconst afterThink = parts.length > 0 ? parts[parts.length - 1].trim() : '';\n\n// 找到第一个非空行作为 URL\nconst lines = afterThink.split('\\n').map(line => line.trim()).filter(Boolean);\nconst candidate = lines.length > 0 ? lines[0] : '';\n\n// 校验是否是 http 或 https 开头的合法 URL\nif (candidate.startsWith('http://') || candidate.startsWith('https://')) {\n  return [\n    {\n      json: {\n        url: candidate\n      }\n    }\n  ];\n} else {\n  // 返回说明信息而不是空数组\n  return [\n    {\n      json: {\n        url: \"无相关url\"\n      }\n    }\n  ];\n}\n"
      },
