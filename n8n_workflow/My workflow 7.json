      "parameters": {
        "jsCode": "// 假设输入是一个 JSON 字符串，存在 items[0].json.content 中\nconst rawOutput = $input.first().json.output;\n\n// 去除 Markdown 代码块包裹，如 ```json ... ``` 或 ``` ... ```\nfunction removeCodeBlockMarkers(text) {\n  // 去除 ```json 和 ``` 包裹的代码块标记，保留中间内容\n  // 支持多行匹配，非贪婪匹配代码块内容\n  return text.replace(/```(?:json)?\\s*([\\s\\S]*?)```/g, \"$1\").trim();\n}\nfunction parseJson(inputText) {\n  try {\n    const parsed = JSON.parse(inputText);\n    return parsed;\n  } catch (e) {\n    throw new Error(\"JSON 解析失败：\" + e.message);\n  }\n}\n// 先去掉代码块标记\nconst cleanedOutput = removeCodeBlockMarkers(rawOutput);\nconst result = parseJson(cleanedOutput);\n\n// 输出解析后的对象\nreturn [\n  {\n    json: result\n  }\n];"
      },
